rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  PÁGINAS PÚBLICAS / EVENTOS (sem login) — leitura e escrita liberadas
    //  (mantém o comportamento que já funcionava antes)
    // ============================================================
    match /cadetes_pontuacao/{doc}  { allow read, write: if true; }  // ranking dos cadetes
    match /album-efesios/{doc}      { allow read, write: if true; }  // álbum de Efésios
    match /desafio-1corintios/{doc} { allow read, write: if true; }  // desafio de leitura
    match /tapago_posts/{doc}       { allow read, write: if true; }  // tá pago
    match /agenda/{doc}             { allow read, write: if true; }
    match /agenda-adpatu/{doc}      { allow read, write: if true; }
    match /membros/{doc}            { allow read, write: if true; }
    match /config/{doc}             { allow read, write: if true; }
    match /ebd_videos/{doc}         { allow read, write: if true; }

    // ============================================================
    //  CENTRAL DO AMOR (com login Google)
    // ============================================================
    match /central-amor-cantadas/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;                       // curtidas
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;      // só o dono apaga
    }
    match /central-amor-usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ============================================================
    //  80 ANOS AD PATU · EBO (inscrição por CPF, check-in na recepção)
    //  A recepção entra com uma senha conferida só na página (recepcao-80.html),
    //  então estas coleções ficam abertas para leitura e escrita sem login.
    // ============================================================
    match /inscricoes-80anos/{cpf} {
      allow read: if true;
      allow create, update: if cpf.matches('^[0-9]{11}$') && request.resource.data.cpf == cpf;
      allow delete: if true;
    }

    match /config-80anos/{doc} {
      allow read, write: if true;
    }

    // ============================================================
    //  ENEM BÍBLICO · DJAD (inscrição pública, lista só para admins)
    //  O nome (sem acento, minúsculo, com hífens) é o ID: só dá para CRIAR,
    //  então o mesmo nome não se inscreve duas vezes e ninguém de fora lê a lista.
    //  Admins: e-mails em config-enem/admins (o 1º login no admin reivindica).
    // ============================================================
    function enemAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config-enem/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config-enem/admins).data.emails;
    }
    function enemAberta() {
      return !exists(/databases/$(database)/documents/config-enem/publico)
        || get(/databases/$(database)/documents/config-enem/publico).data.get('aberta', true) != false;
    }

    match /enem-inscricoes/{id} {
      allow create: if id.matches('^[a-z0-9]+(-[a-z0-9]+)+$') && id.size() <= 90
        && request.resource.data.keys().hasOnly(['nome', 'criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 5 && request.resource.data.nome.size() <= 80
        && request.resource.data.criadoEm == request.time
        && enemAberta();
      allow read, update, delete: if enemAdmin();
    }

    match /config-enem/publico {
      allow read: if true;
      allow write: if enemAdmin();
    }

    match /config-enem/admins {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails == [request.auth.token.email];
      allow update: if enemAdmin()
        && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails is list;
    }
  }
}
