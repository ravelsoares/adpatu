rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  PÁGINAS PÚBLICAS / EVENTOS (sem login) — leitura e escrita liberadas
    //  (mantém o comportamento que já funcionava antes)
    // ============================================================
    match /cadetes_pontuacao/{doc}  { allow read, write: if true; }  // ranking dos cadetes
    match /album-efesios/{doc}      { allow read, write: if true; }  // álbum de Efésios
    match /desafio-1corintios/{doc} { allow read, write: if true; }  // desafio de leitura
    match /tapago_posts/{doc}       { allow read, write: if true; }  // tá pago
    match /agenda/{doc}             { allow read, write: if true; }
    match /agenda-adpatu/{doc}      { allow read, write: if true; }
    match /membros/{doc}            { allow read, write: if true; }
    match /config/{doc}             { allow read, write: if true; }
    match /ebd_videos/{doc}         { allow read, write: if true; }

    // ============================================================
    //  CENTRAL DO AMOR (com login Google)
    // ============================================================
    match /central-amor-cantadas/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;                       // curtidas
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;      // só o dono apaga
    }
    match /central-amor-usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
