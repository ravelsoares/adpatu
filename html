<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Censo UMADCAMP</title>
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
            padding: 30px;
            text-align: center;
            position: relative;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .nav-links {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            gap: 10px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            padding: 8px 15px;
            border: 1px solid white;
            border-radius: 20px;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .nav-links a:hover {
            background: white;
            color: #2c3e50;
        }

        .main-content {
            padding: 30px;
        }

        .form-section {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            border: 1px solid #e0e6ed;
        }

        .form-section h2 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-size: 1.5em;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-row {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #2c3e50;
            font-weight: 600;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e6ed;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

        .form-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        .btn-danger {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
            padding: 8px 12px;
            font-size: 12px;
        }

        .members-section {
            margin-top: 30px;
        }

        .members-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .members-count {
            background: linear-gradient(135deg, #52c234 0%, #61b15a 100%);
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: 600;
        }

        .search-box {
            padding: 10px 15px;
            border: 2px solid #e0e6ed;
            border-radius: 10px;
            width: 250px;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .search-box:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        select.search-box {
            cursor: pointer;
        }

        .members-table {
            width: 100%;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            border: 1px solid #e0e6ed;
        }

        .members-table thead {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
        }

        .members-table th,
        .members-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #e0e6ed;
        }

        .members-table th {
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .members-table th[data-sort] {
            cursor: pointer;
            user-select: none;
        }

        .members-table th[data-sort]:hover {
            background-color: #3c5168;
        }

        .sort-indicator {
            display: inline-block;
            width: 0;
            height: 0;
            margin-left: 8px;
            vertical-align: middle;
            border-left: 5px solid transparent;
            border-right: 5px solid transparent;
            opacity: 0.4;
        }

        .members-table th.sorted-asc .sort-indicator {
            opacity: 1;
            border-bottom: 5px solid white;
        }

        .members-table th.sorted-desc .sort-indicator {
            opacity: 1;
            border-top: 5px solid white;
        }

        .members-table tbody tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
            transition: all 0.2s ease;
        }

        .sequence-number {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }

        .age-badge {
            background: #e3f2fd;
            color: #1976d2;
            padding: 4px 8px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: 600;
        }

        .no-members {
            text-align: center;
            padding: 40px;
            color: #666;
            font-style: italic;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
            padding: 20px;
            border-radius: 15px;
            text-align: center;
            border: 1px solid #e0e6ed;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .stat-number {
            font-size: 2em;
            font-weight: 700;
            color: #2c3e50;
        }

        .stat-label {
            color: #666;
            font-size: 0.9em;
            margin-top: 5px;
        }

        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .loading-content {
            background: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .error-message {
            background: #ffebee;
            color: #c62828;
            padding: 10px 15px;
            border-radius: 10px;
            margin: 10px 0;
            border-left: 4px solid #c62828;
        }

        .success-message {
            background: #e8f5e8;
            color: #2e7d32;
            padding: 10px 15px;
            border-radius: 10px;
            margin: 10px 0;
            border-left: 4px solid #2e7d32;
        }

        /* Modal de Edição */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
        }

        .modal-content {
            background-color: white;
            margin: 5% auto;
            padding: 0;
            border-radius: 20px;
            width: 90%;
            max-width: 600px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            animation: modalSlideIn 0.3s ease-out;
        }

        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
            padding: 20px 30px;
            border-radius: 20px 20px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 1.5em;
        }

        .close {
            color: white;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            transition: opacity 0.3s ease;
        }

        .close:hover {
            opacity: 0.7;
        }

        .modal-body {
            padding: 30px;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-right: 5px;
        }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(243, 156, 18, 0.3);
        }

        .btn-save {
            background: linear-gradient(135deg, #52c234 0%, #61b15a 100%);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
        }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(82, 194, 52, 0.3);
        }

        .btn-save:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 10px;
        }

        .btn-cancel:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(149, 165, 166, 0.3);
        }

        .role-tag {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 600;
            margin-left: 8px;
            vertical-align: middle;
            color: white;
        }

        .role-tag-lider {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        }

        .role-tag-vice-lider {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        }

        @media (max-width: 768px) {
            .form-row {
                flex-direction: column;
            }

            .members-header {
                flex-direction: column;
                gap: 15px;
            }

            .members-header>div {
                flex-direction: column;
                gap: 10px;
            }

            .members-header>div>button {
                width: 100%;
            }

            .search-box {
                width: 100%;
            }

            .members-table {
                font-size: 14px;
            }

            .members-table th,
            .members-table td {
                padding: 10px;
            }

            .modal-content {
                width: 95%;
                margin: 10% auto;
            }

            .modal-body {
                padding: 20px;
            }

            .btn-edit {
                font-size: 10px;
                padding: 6px 8px;
                margin-right: 3px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <div class="nav-links">
                <a href="agenda.html">Agenda</a>
                <a href="admin.html">Admin</a>
            </div>
            <h1>UMADCAMP</h1>
            <p>União de Mocidades da Igreja Evangélica Assembleia de Deus do Campo de Patu</p>
        </div>

        <div class="main-content">
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-number" id="totalMembros">0</div>
                    <div class="stat-label">Total de Membros</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="idadeMedia">0</div>
                    <div class="stat-label">Idade Média</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="maisJovem">-</div>
                    <div class="stat-label">Mais Jovem</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="maisVelho">-</div>
                    <div class="stat-label">Mais Velho</div>
                </div>
            </div>

            <div class="members-section">
                <div class="members-header">
                    <h2>Membros Cadastrados</h2>
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <input type="text" id="searchInput" class="search-box" placeholder="Pesquisar por nome...">
                        <select id="cityFilter" class="search-box" style="width: 200px;">
                            <option value="">Todas as cidades</option>
                        </select>
                        <select id="roleFilter" class="search-box" style="width: 150px;">
                            <option value="">Todos os cargos</option>
                            <option value="Líder">Líder</option>
                            <option value="Vice-líder">Vice-líder</option>
                            <option value="sem_cargo">Sem Cargo</option>
                        </select>
                        <button class="btn" onclick="limparFiltros()" style="padding: 10px 15px; font-size: 12px;">
                            🔄 Limpar Filtros
                        </button>
                    </div>
                </div>

                <table class="members-table">
                    <thead>
                        <tr>
                            <th data-sort="numero">Nº<span class="sort-indicator"></span></th>
                            <th data-sort="nome">Nome<span class="sort-indicator"></span></th>
                            <th data-sort="dataNascimento">Data de Nascimento<span class="sort-indicator"></span></th>
                            <th>Idade</th>
                            <th data-sort="cidade">Cidade<span class="sort-indicator"></span></th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody">
                        <tr class="no-members">
                            <td colspan="5">Nenhum membro cadastrado ainda</td>
                        </tr>
                    </tbody>
            </div>
        </div>
    </div>

    <script>
        // Configuração do Firebase
        // IMPORTANTE: Para usar esta aplicação, você precisa:
        // 1. Criar um projeto no Firebase Console (https://console.firebase.google.com)
        // 2. Ativar o Firestore Database
        // 3. Configurar as regras de segurança (modo de teste para desenvolvimento)
        // 4. Obter as configurações do projeto e substituir os valores abaixo
        // const firebaseConfig = { // MODELO
        //     apiKey: "sua-api-key-aqui",
        //     authDomain: "seu-projeto.firebaseapp.com",
        //     projectId: "seu-projeto-id",
        //     storageBucket: "seu-projeto.appspot.com",
        //     messagingSenderId: "123456789",
        //     appId: "sua-app-id"
        // };

        const firebaseConfig = {
            apiKey: "AIzaSyCjQ4sgU_EmRi-RTrzchIS60bumYC-M9QQ",
            authDomain: "umadcamp-patu.firebaseapp.com",
            projectId: "umadcamp-patu",
            storageBucket: "umadcamp-patu.firebasestorage.app",
            messagingSenderId: "1043102355965",
            appId: "1:1043102355965:web:734bcffb30d37a7d2b8994",
            measurementId: "G-S6N9R4F8Z8"
        };

        // Inicializar Firebase
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        let membros = [];
        let proximoNumero = 1;
        let isLoading = false;
        let sortState = { column: 'numero', direction: 'asc' };

        // Funções de utilidade
        function showLoading(show = true) {
            if (show) {
                const overlay = document.createElement('div');
                overlay.className = 'loading-overlay';
                overlay.id = 'loadingOverlay';
                overlay.innerHTML = `
                    <div class="loading-content">
                        <div class="loading"></div>
                        <p style="margin-top: 15px;">Carregando...</p>
                    </div>
                `;
                document.body.appendChild(overlay);
            } else {
                const overlay = document.getElementById('loadingOverlay');
                if (overlay) {
                    overlay.remove();
                }
            }
        }

        function calcularIdade(dataNascimento) {
            const hoje = new Date();
            const nascimento = new Date(dataNascimento);
            let idade = hoje.getFullYear() - nascimento.getFullYear();
            const mes = hoje.getMonth() - nascimento.getMonth();

            if (mes < 0 || (mes === 0 && hoje.getDate() < nascimento.getDate())) {
                idade--;
            }

            return idade;
        }

        function formatarData(data) {
            return new Date(data).toLocaleDateString('pt-BR');
        }

        function criarCargoTag(cargo) {
            if (!cargo) return '';

            const cargoClass = cargo.toLowerCase() === 'líder' ? 'role-tag-lider' : 'role-tag-vice-lider';
            return `<span class="role-tag ${cargoClass}">${cargo}</span>`;
        }

        function atualizarTabela(membrosParaExibir = membros) {
            const tbody = document.getElementById('membersTableBody');

            if (membrosParaExibir.length === 0) {
                tbody.innerHTML = '<tr class="no-members"><td colspan="5">Nenhum membro encontrado</td></tr>';
                return;
            }

            tbody.innerHTML = membrosParaExibir.map(membro => `
                <tr>
                    <td><span class="sequence-number">${membro.numero}</span></td>
                    <td>${membro.nome}${criarCargoTag(membro.cargo)}</td>
                    <td>${formatarData(membro.dataNascimento)}</td>
                    <td><span class="age-badge">${membro.idade} anos</span></td>
                    <td>${membro.cidade}</td>
                </tr>
            `).join('');
        }

        function atualizarEstatisticas(membrosParaCalcular = membros) {
            const total = membrosParaCalcular.length;
            document.getElementById('totalMembros').textContent = total;

            if (total > 0) {
                const idades = membrosParaCalcular.map(m => m.idade);
                const idadeMedia = Math.round(idades.reduce((a, b) => a + b, 0) / total);
                const maisJovem = Math.min(...idades);
                const maisVelho = Math.max(...idades);

                document.getElementById('idadeMedia').textContent = idadeMedia;
                document.getElementById('maisJovem').textContent = maisJovem;
                document.getElementById('maisVelho').textContent = maisVelho;
            } else {
                document.getElementById('idadeMedia').textContent = '0';
                document.getElementById('maisJovem').textContent = '-';
                document.getElementById('maisVelho').textContent = '-';
            }
        }

        function pesquisarMembros(termo) {
            const termoLower = termo.toLowerCase();
            const cidadeSelecionada = document.getElementById('cityFilter').value;
            const cargoSelecionado = document.getElementById('roleFilter').value;

            let resultados = membros.filter(membro =>
                membro.nome.toLowerCase().includes(termoLower)
            );

            if (cidadeSelecionada) {
                resultados = resultados.filter(membro =>
                    membro.cidade === cidadeSelecionada
                );
            }

            if (cargoSelecionado) {
                if (cargoSelecionado === 'sem_cargo') {
                    resultados = resultados.filter(membro => !membro.cargo);
                } else {
                    resultados = resultados.filter(membro => membro.cargo === cargoSelecionado);
                }
            }

            atualizarTabela(resultados);
            atualizarEstatisticas(resultados);
            atualizarIndicadorFiltros(termo, cidadeSelecionada, cargoSelecionado);
        }

        function atualizarIndicadorFiltros(termo, cidade, cargo) {
            const temFiltros = termo || cidade || cargo;
            const statsContainer = document.querySelector('.stats');

            if (temFiltros) {
                statsContainer.style.border = '2px solid #667eea';
                statsContainer.style.borderRadius = '15px';
                statsContainer.style.padding = '20px';
                statsContainer.style.background = 'linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%)';

                // Adicionar texto indicativo
                let textoFiltro = '📊 Estatísticas dos dados filtrados';
                if (cidade) {
                    textoFiltro += ` (Cidade: ${cidade})`;
                }
                if (cargo) {
                    if (cargo === 'sem_cargo') {
                        textoFiltro += ` (Sem Cargo)`;
                    } else {
                        textoFiltro += ` (Cargo: ${cargo})`;
                    }
                }
                if (termo) {
                    textoFiltro += ` (Busca: "${termo}")`;
                }

                // Remover indicador anterior se existir
                const indicadorAnterior = document.getElementById('filtroIndicador');
                if (indicadorAnterior) {
                    indicadorAnterior.remove();
                }

                // Adicionar novo indicador
                const indicador = document.createElement('div');
                indicador.id = 'filtroIndicador';
                indicador.style.cssText = `
                    text-align: center;
                    margin-bottom: 15px;
                    padding: 10px;
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    color: white;
                    border-radius: 10px;
                    font-weight: 600;
                    font-size: 14px;
                `;
                indicador.textContent = textoFiltro;
                statsContainer.insertBefore(indicador, statsContainer.firstChild);
            } else {
                statsContainer.style.border = 'none';
                statsContainer.style.padding = '0';
                statsContainer.style.background = 'none';

                const indicador = document.getElementById('filtroIndicador');
                if (indicador) {
                    indicador.remove();
                }
            }
        }

        function atualizarFiltroCidades() {
            const cityFilter = document.getElementById('cityFilter');
            const cidades = [...new Set(membros.map(membro => membro.cidade))].sort();

            // Manter a opção "Todas as cidades" e limpar as outras
            cityFilter.innerHTML = '<option value="">Todas as cidades</option>';

            cidades.forEach(cidade => {
                const option = document.createElement('option');
                option.value = cidade;
                option.textContent = cidade;
                cityFilter.appendChild(option);
            });
        }

        function aplicarFiltros() {
            const termo = document.getElementById('searchInput').value;
            pesquisarMembros(termo);
        }

        function limparFiltros() {
            document.getElementById('searchInput').value = '';
            document.getElementById('cityFilter').value = '';
            document.getElementById('roleFilter').value = '';
            atualizarTabela();
            atualizarEstatisticas();
            atualizarIndicadorFiltros('', '', '');
        }

        function sortMembros() {
            const { column, direction } = sortState;
            const modifier = direction === 'asc' ? 1 : -1;

            membros.sort((a, b) => {
                const valA = a[column];
                const valB = b[column];

                if (column === 'nome' || column === 'cidade') {
                    return (valA || '').localeCompare(valB || '', 'pt-BR', { sensitivity: 'base' }) * modifier;
                }

                if (column === 'dataNascimento') {
                    const dateA = new Date(valA);
                    const dateB = new Date(valB);
                    if (dateA > dateB) return 1 * modifier;
                    if (dateA < dateB) return -1 * modifier;
                    return 0;
                }

                if (column === 'numero') {
                    return (valA - valB) * modifier;
                }

                return 0;
            });
        }

        function handleSort(column) {
            if (isLoading) return;

            if (sortState.column === column) {
                sortState.direction = sortState.direction === 'asc' ? 'desc' : 'asc';
            } else {
                sortState.column = column;
                sortState.direction = 'asc';
            }

            sortMembros();
            pesquisarMembros(document.getElementById('searchInput').value); // Re-render with filters
            updateSortIndicators();
        }

        function updateSortIndicators() {
            document.querySelectorAll('.members-table th[data-sort]').forEach(th => {
                th.classList.remove('sorted-asc', 'sorted-desc');
                if (th.dataset.sort === sortState.column) {
                    th.classList.add(sortState.direction === 'asc' ? 'sorted-asc' : 'sorted-desc');
                }
            });
        }

        async function carregarMembros() {
            if (isLoading) return;

            isLoading = true;
            showLoading(true);

            try {
                const snapshot = await db.collection('membros').orderBy('numero', 'asc').get();

                membros = [];
                snapshot.forEach(doc => {
                    const data = doc.data();
                    membros.push({
                        id: doc.id,
                        ...data
                    });
                });

                // Atualizar próximo número
                if (membros.length > 0) {
                    proximoNumero = Math.max(...membros.map(m => m.numero)) + 1;
                } else {
                    proximoNumero = 1;
                }

                // Atualizar interface
                atualizarTabela();
                atualizarEstatisticas();
                atualizarFiltroCidades();
                updateSortIndicators();

            } catch (error) {
                console.error('Erro ao carregar membros:', error);
                alert('Erro ao carregar dados. Verifique sua conexão e tente recarregar a página.');
            } finally {
                isLoading = false;
                showLoading(false);
            }
        }

        // Event Listeners
        document.getElementById('searchInput').addEventListener('input', function (e) {
            pesquisarMembros(e.target.value);
        });

        document.getElementById('cityFilter').addEventListener('change', function (e) {
            aplicarFiltros();
        });

        document.getElementById('roleFilter').addEventListener('change', function (e) {
            aplicarFiltros();
        });

        document.querySelector('.members-table thead').addEventListener('click', (event) => {
            const header = event.target.closest('th[data-sort]');
            if (!header) return;

            const column = header.dataset.sort;
            handleSort(column);
        });

        // Inicialização
        document.addEventListener('DOMContentLoaded', function () {
            carregarMembros();
        });
    </script>
</body>
</html>